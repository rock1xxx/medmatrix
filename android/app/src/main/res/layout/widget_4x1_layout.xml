<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Left Half: Ward MCQs (Multi-Item Queue, Pushed to Edge, No Inner Box) -->
    <LinearLayout
        android:id="@+id/card_ward_mcqs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="9dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Top Pill Tag: Pushed to Edge, No Subject Clutter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_emerald_bg"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:text="🩺 WARD MCQ"
            android:textColor="#34D399"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Chapter 1 Title -->
        <TextView
            android:id="@+id/widget_mcq_ch1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sterilization &amp; Disinfection"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Chapter 2 Title -->
        <TextView
            android:id="@+id/widget_mcq_ch2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Bacterial Culture Media"
            android:textColor="#CBD5E1"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Center Line Divider (1dp, subtle translucent white line) -->
    <View
        android:id="@+id/widget_center_divider"
        android:layout_width="1dp"
        android:layout_height="46dp"
        android:background="#2EFFFFFF" />

    <!-- Right Half: Tonight's Videos (Multi-Item Queue, Pushed to Edge, No Inner Box) -->
    <LinearLayout
        android:id="@+id/card_tonight_videos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="9dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Top Pill Tag: Pushed to Edge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:text="🌙 TONIGHT"
            android:textColor="#38BDF8"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Video 1 Title -->
        <TextView
            android:id="@+id/widget_video_ch1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Bacterial Genetics (34m)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Video 2 Title -->
        <TextView
            android:id="@+id/widget_video_ch2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Drug Resistance (21m)"
            android:textColor="#CBD5E1"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
