<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      Dedicated background layer so opacity can be applied without fading the text.

      This MUST be an ImageView (or another @RemoteViews.RemoteView class) and never a
      bare <View>. RemoteViews inflates widget layouts through a LayoutInflater whose
      filter only allows classes annotated with @RemoteViews.RemoteView, and
      android.view.View is not one of them, so a plain <View> throws InflateException
      inside the launcher and the widget dies with "Couldn't add widget" / "Problem
      loading widget". ImageView is on the supported list.
    -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_frosted_24"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <!-- Content row wraps its text, so the divider inside it never spans the widget -->
    <LinearLayout
        android:id="@+id/widget_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Left Half: Ward MCQs -->
        <LinearLayout
            android:id="@+id/card_ward_mcqs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_emerald_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="🩺 WARD MCQ"
                android:textColor="#34D399"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_mcq_ch1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sterilization &amp; Disinfection"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_mcq_ch2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bacterial Culture Media"
                android:textColor="#CBD5E1"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!--
          Center divider. Height is match_parent inside a wrap_content row, so
          LinearLayout re-measures it to exactly the height of the tallest text
          column: the line tracks the text at any font scale instead of spanning the
          whole widget. Again an ImageView, never a bare <View> (see widget_bg).
        -->
        <ImageView
            android:id="@+id/widget_center_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:minHeight="30dp"
            android:background="#2EFFFFFF"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <!-- Right Half: Tonight's Videos -->
        <LinearLayout
            android:id="@+id/card_tonight_videos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="🌙 TONIGHT"
                android:textColor="#38BDF8"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_video_ch1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bacterial Genetics (34m)"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_video_ch2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Drug Resistance (21m)"
                android:textColor="#CBD5E1"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
